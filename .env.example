# AI ENGINE CONFIGURATION (Primary: Gemini, Fallback: OpenRouter)
GEMINI_API_KEY="your_gemini_api_key_here"
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# CONVEX CONFIGURATION
CONVEX_DEPLOYMENT="dev:your-deployment-name|your-key"
VITE_CONVEX_URL="https://your-instance.convex.cloud"
CONVEX_URL="https://your-instance.convex.cloud"
VITE_CONVEX_SITE_URL="https://your-instance.convex.site"

# Server-to-Convex shared secret. Must be set BOTH here (server/Vercel env) AND in
# the Convex deployment env vars. Required for the serverless gateway to call Convex
# functions on behalf of a verified admin/student session. WITHOUT it, all Convex
# admin and student operations require a live Clerk session identity — no identity,
# no access.
CONVEX_SERVER_SECRET="generate_a_long_random_string"

# ADMIN EMAIL CONFIGURATION (Supports multiple admins, comma-separated)
ADMIN_EMAILS="reddysantosh1310@gmail.com,suchandramanne@gmail.com"
ADMIN_EMAIL="reddysantosh1310@gmail.com"
VITE_ADMIN_EMAILS="reddysantosh1310@gmail.com,suchandramanne@gmail.com"
VITE_ADMIN_EMAIL="reddysantosh1310@gmail.com"

# CLERK AUTHENTICATION
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_key_here"
CLERK_SECRET_KEY="sk_test_your_key_here"

# LOCAL DEVELOPMENT ONLY: when CLERK_SECRET_KEY is absent, set both of these to
# let unauthenticated requests pass as "local-dev-user". Never set in production.
# NODE_ENV=development
# ALLOW_DEV_AUTH_BYPASS="true"
